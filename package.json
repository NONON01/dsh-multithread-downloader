{
  "name": "dsh-multithread-downloader",
  "version": "1.0.0",
  "type": "module",
  "description": "多线程分片 HTTP/HTTPS 下载器（DSH 插件）：Host 端分片并发、断点续传、请求头、镜像、校验、限速与 Agent 工具。",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "bin/picker.exe",
    "bin/picker.cs",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "PUBLISHING.md",
    "bin/build.ps1"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "NONON01",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "download",
    "http",
    "range",
    "multithread"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.2"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NONON01/dsh-multithread-downloader.git"
  },
  "homepage": "https://github.com/NONON01/dsh-multithread-downloader#readme",
  "bugs": {
    "url": "https://github.com/NONON01/dsh-multithread-downloader/issues"
  }
}
